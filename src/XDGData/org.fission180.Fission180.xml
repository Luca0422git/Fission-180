<?xml version="1.0" encoding="UTF-8"?>
<!-- FISSION180: Fission 180 opens FreeCAD's document format; this registers the same MIME type
     under Fission 180's own file name so it can be installed next to FreeCAD's. -->
<mime-info xmlns='http://www.freedesktop.org/standards/shared-mime-info'>
  <mime-type type="application/x-extension-fcstd">
    <comment>Fission 180 / FreeCAD document</comment>
    <glob pattern="*.fcstd"/>
    <generic-icon name="application-x-extension-fcstd"/>
  </mime-type>
</mime-info>
