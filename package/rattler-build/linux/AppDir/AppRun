#!/bin/bash
HERE="$(dirname "$(readlink -f "${0}")")"
export PREFIX=${HERE}/usr
# export LD_LIBRARY_PATH=${HERE}/usr/lib${LD_LIBRARY_PATH:+':'}$LD_LIBRARY_PATH
export PYTHONHOME=${HERE}/usr
export PATH_TO_FREECAD_LIBDIR=${HERE}/usr/lib
# export QT_QPA_PLATFORM_PLUGIN_PATH=${HERE}/usr/plugins
# export QT_XKB_CONFIG_ROOT=${HERE}/usr/lib
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
export FONTCONFIG_PATH=/etc/fonts

# Fix: Use X to run on Wayland
export QT_QPA_PLATFORM=xcb

# FISSION180: the graphics driver (Mesa, NVIDIA) always comes from the system, so its libdrm
# must too: the bundled (conda) libdrm is older than a rolling distribution's Mesa needs, and
# being loaded first it hid the system's (CachyOS, Mesa 26.2: "undefined symbol:
# amdgpu_va_manager_query_sw_info", no OpenGL, the program aborted: "Could not initialize
# GLX"). The system's libdrm libraries go first when they are there (64-bit folders only:
# Fedora's /usr/lib holds 32-bit ones). FISSION180_BUNDLED_LIBDRM=1 keeps the bundled ones.
# (docs/fission180/core-patches.md #12)
if [ "${FISSION180_BUNDLED_LIBDRM:-0}" != 1 ]; then
    FISSION180_PRELOAD=""
    for lib in libdrm.so.2 libdrm_amdgpu.so.1 libdrm_radeon.so.1 libdrm_intel.so.1 libdrm_nouveau.so.2; do
        for dir in /usr/lib64 /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib; do
            if [ -e "$dir/$lib" ]; then
                FISSION180_PRELOAD="${FISSION180_PRELOAD:+$FISSION180_PRELOAD:}$dir/$lib"
                break
            fi
        done
    done
    if [ -n "$FISSION180_PRELOAD" ]; then
        export LD_PRELOAD="${FISSION180_PRELOAD}${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
    unset FISSION180_PRELOAD
fi

# Show packages info if DEBUG env variable is set
if [ "$DEBUG" = 1 ]; then
    cat ${HERE}/packages.txt
fi

# SSL
# https://forum.freecad.org/viewtopic.php?f=4&t=34873&start=20#p327416
export SSL_CERT_FILE=$PREFIX/ssl/cacert.pem
# https://github.com/FreeCAD/FreeCAD-AppImage/pull/20
export GIT_SSL_CAINFO=$HERE/usr/ssl/cacert.pem

# Support for launching other applications (from /usr/bin)
# https://github.com/FreeCAD/FreeCAD-AppImage/issues/30
# FISSION180: the programs are fission180 and fission180cmd; "freecad" and "freecadcmd" still
# work as names (tools/fission180/run_tests.sh uses them for the official FreeCAD AppImage too)
# (docs/fission180/core-patches.md #12).
case "${1:-}" in
    freecad) [ -e "$HERE/usr/bin/freecad" ] || set -- fission180 "${@:2}" ;;
    freecadcmd) [ -e "$HERE/usr/bin/freecadcmd" ] || set -- fission180cmd "${@:2}" ;;
esac
if [ ! -z "$1" ] && [ -e "$HERE/usr/bin/$1" ] ; then
    MAIN="$HERE/usr/bin/$1" ; shift
else
    MAIN="$HERE/usr/bin/fission180"
fi

"${MAIN}" "$@"
