#!/usr/bin/env bash
# Fission 180 on the command line: the AI tools without the window (src/Mod/Fission180/fission180/ai/
# cli.py says everything it does).
#
#   tools/fission180/fission180-cli info part.FCStd
#   tools/fission180/fission180-cli convert part.FCStd part.step
#   tools/fission180/fission180-cli run --tool 'create_sketch {"plane": "XY", "geometry":
#       [{"rect": [0, 0, 40, 20]}]}' --tool 'extrude {"profile": "Sketch1", "distance": 10}' \
#       --save box.FCStd
#   tools/fission180/fission180-cli check part.FCStd
#   tools/fission180/fission180-cli render part.FCStd part.png --view top --size 800x600
#   tools/fission180/fission180-cli tools
#   tools/fission180/fission180-cli docs search "fillet radius too big"
#   tools/fission180/fission180-cli docs export Fission180-for-AI.md
#   tools/fission180/fission180-cli mcp --headless
#
# FreeCAD is looked for in $FISSION180_FREECAD (an unpacked AppImage folder or an install prefix),
# then .fission180-cache/freecad (tools/fission180/get_freecad.sh), then fission180cmd / freecadcmd on
# the PATH. With stock FreeCAD, Fission 180's module is linked in through a throw-away profile so
# your own FreeCAD settings are not touched (unless FISSION180_CLI_PROFILE names a profile).
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MODULE="${REPO}/src/Mod/Fission180"
CLI="${MODULE}/fission180/ai/cli.py"

# "tools" and "docs" need no FreeCAD: any Python reads the catalogue and the documents.
if { [ "${1:-}" = "tools" ] || [ "${1:-}" = "docs" ]; } && command -v python3 >/dev/null; then
    exec python3 "${CLI}" "$@"
fi

FREECAD_DIR="${FISSION180_FREECAD:-${REPO}/.fission180-cache/freecad}"
FC_CMD=()
ADDON=0
if [ -x "${FREECAD_DIR}/squashfs-root/AppRun" ]; then
    if [ -x "${FREECAD_DIR}/squashfs-root/usr/bin/fission180cmd" ]; then
        FC_CMD=("${FREECAD_DIR}/squashfs-root/AppRun" fission180cmd)
    else
        FC_CMD=("${FREECAD_DIR}/squashfs-root/AppRun" freecadcmd)
    fi
    [ -d "${FREECAD_DIR}/squashfs-root/usr/Mod/Fission180" ] || ADDON=1
elif ls "${FREECAD_DIR}"/bin/{Fission180Cmd,fission180cmd,FreeCADCmd,freecadcmd} >/dev/null 2>&1; then
    FC_CMD=("$(ls "${FREECAD_DIR}"/bin/{Fission180Cmd,fission180cmd,FreeCADCmd,freecadcmd} 2>/dev/null | head -1)")
elif command -v fission180cmd >/dev/null; then
    FC_CMD=("$(command -v fission180cmd)")
elif command -v freecadcmd >/dev/null; then
    FC_CMD=("$(command -v freecadcmd)")
    ADDON=1
fi
if [ ${#FC_CMD[@]} -eq 0 ]; then
    echo "[Fission 180] FreeCAD's command-line program was not found: set FISSION180_FREECAD or run" \
        "tools/fission180/get_freecad.sh" >&2
    exit 2
fi

if [ -z "${FISSION180_CLI_PROFILE:-}" ]; then
    PROFILE="$(mktemp -d)"
    trap 'rm -rf "${PROFILE}" "${ARGFILE:-}"' EXIT
    mkdir -p "${PROFILE}/Mod"
    [ "${ADDON}" = 1 ] && ln -s "${MODULE}" "${PROFILE}/Mod/Fission180"
    export FREECAD_USER_HOME="${PROFILE}"
else
    export FREECAD_USER_HOME="${FISSION180_CLI_PROFILE}"
fi
export LANG="${LANG:-C.UTF-8}"

# FreeCAD's command-line program reads options itself (only one argument may follow --pass),
# so the arguments travel in a file, NUL-separated. (Relative paths are taken from where the
# command was typed.)
ARGFILE="$(mktemp)"
printf '%s\0' "$@" > "${ARGFILE}"
FISSION180_CLI_ARGFILE="${ARGFILE}" "${FC_CMD[@]}" "${CLI}"
CODE=$?
rm -f "${ARGFILE}"
exit ${CODE}
